# Optional — the platform runs in deterministic demo mode without this.
# Add an Anthropic API key to enable live AI forensic analysis, the streaming
# investigator, AI dossiers, project-health narration, and vision photo analysis.
ANTHROPIC_API_KEY=

# Optional — your deployed origin, used for robots.txt + sitemap.xml absolute URLs.
# e.g. https://ghanawatch.com  (defaults to the Vercel URL if unset)
NEXT_PUBLIC_SITE_URL=

# Optional — production rate limiting. When both are set, the AI routes use
# Upstash Redis for global per-IP limits; otherwise an in-memory fallback is used.
# Create a free DB at https://console.upstash.com → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
